rules_version = '2';

// CertiFi - Firestore Security Rules
// Giai đoạn dev: user đã đăng nhập Firebase Auth được toàn quyền.
// Khi làm phân quyền 3 role (admin/manager/employee) sẽ siết lại
// theo custom claims hoặc field `role` trong collection users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
